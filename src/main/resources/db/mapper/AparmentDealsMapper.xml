<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.home.repository.ApartmentDealsRepository">
    <resultMap id="ApartmentDealResultMap" type="com.ssafy.home.dto.apartment.ApartmentDealsDto">
        <id property="apartmentDealsId" column="apartment_deals_id"/>
        <result property="aptSeq" column="apt_seq"/>
        <result property="aptDong" column="apt_dong"/>
        <result property="dealFloor" column="deal_floor"/>
        <result property="dealYear" column="deal_year"/>
        <result property="dealMonth" column="deal_month"/>
        <result property="dealDay" column="deal_day"/>
        <result property="dealExcluUseAr" column="deal_exclu_use_ar"/>
        <result property="dealAmount" column="deal_amount"/>
    </resultMap>

    <select id="findDealsByApartmentSeq" resultMap="ApartmentDealResultMap">
        SELECT apartment_deals_id,
               apt_seq,
               apt_dong,
               deal_floor,
               deal_year,
               deal_month,
               deal_day,
               deal_exclu_use_ar,
               deal_amount
        FROM Apartment_Deals
        WHERE apt_seq = #{aptSeq}
    </select>
</mapper>
